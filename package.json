{
  "name": "backend-web-portal-siswa",
  "version": "1.0.0",
  "description": "Backend REST API untuk Web Portal Siswa (PKL, Absensi, Keuangan)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "migrate": "tsx src/seeders/migrate.ts",
    "migrate:prod": "node dist/seeders/migrate.js",
    "seed": "tsx src/seeders/seed.ts",
    "seed:prod": "node dist/seeders/seed.js",
    "db:setup": "tsx src/seeders/migrate.ts && tsx src/seeders/seed.ts",
    "db:setup:prod": "node dist/seeders/migrate.js && node dist/seeders/seed.js",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "keywords": [
    "express",
    "portal-siswa",
    "rest-api",
    "pkm"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "file-type": "^19.6.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
