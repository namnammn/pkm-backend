# ==========================================
# Konfigurasi Lingkungan: Web Portal Siswa API
# ==========================================

# Lingkungan aplikasi ('development' | 'production' | 'test')
NODE_ENV=production
PORT=3000

# PostgreSQL Database Connection String
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/portal_siswa

# JWT Secret Key (Ganti dengan string acak aman di lingkungan produksi!)
JWT_SECRET=super-production-jwt-secret-key-pkm-2026

# Lokasi Penyimpanan Berkas Unggahan (Laporan, Surat Izin, Bukti Bayar)
UPLOAD_DIR=./uploads

# Bobot Nilai Akhir PKL (Konfigurasi Sesuai PRD Bagian 10 Aturan BR-05)
# Nilai Akhir = (BOBOT_SEKOLAH * nilaiSekolah + BOBOT_INDUSTRI * rataRataIndustri) / 100
BOBOT_NILAI_SEKOLAH=40
BOBOT_NILAI_INDUSTRI=60

# Opsi Container Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=portal_siswa
DB_PORT=5432
